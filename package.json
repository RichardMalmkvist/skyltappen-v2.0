{
  "name": "namnskylt-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@azure/storage-blob": "^12.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "fontkit": "^2.0.4",
    "jsbarcode": "^3.12.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "^0.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "sax": "^1.2.4",
    "svg-to-pdfkit": "^0.1.8",
    "three": "^0.187.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node server/server.js",
    "client": "react-scripts start",
    "server": "node --env-file-if-exists=.env server/server.js",
    "import:first-admin": "node scripts/import-first-admin.js",
    "import:local-data": "node scripts/import-local-data.js",
    "dev": "node --env-file-if-exists=.env scripts/check-dev-port.js && concurrently --kill-others-on-fail \"npm run client\" \"npm run server -- --development\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "env": {
      "es2020": true
    },
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/q": "^1.5.8",
    "concurrently": "^9.2.1"
  },
  "proxy": "http://127.0.0.1:8080"
}
